{%- comment -%}
  Splinter Category — flexible on-brand landing page section for the Ride theme.
  Drives the category pages (Drawer Systems, False Floors, 12V) and About:
  a hero, a live product grid from a chosen collection, optional "feature"
  and "faq" blocks, and a closing CTA. Renders real product objects so prices
  and images stay in sync.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="sxc" id="sxc-{{ section.id }}">
  {%- if section.settings.show_hero -%}
    <section class="sxc-hero{% if section.settings.hero_image %} has-img{% endif %}">
      {%- if section.settings.hero_image -%}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'sxc-hero-bg', loading: 'eager', sizes: '100vw', widths: '600,900,1200,1600,2200', alt: section.settings.heading | strip_html }}
      {%- endif -%}
      <div class="sxc-wrap sxc-hero-inner">
        {%- if section.settings.eyebrow != blank -%}<p class="sxc-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="sxc-h1">{{ section.settings.heading }}</h1>
        {%- if section.settings.intro != blank -%}<p class="sxc-intro">{{ section.settings.intro }}</p>{%- endif -%}
        {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
          <div class="sxc-actions">
            {%- if section.settings.btn1_label != blank -%}<a class="sxc-btn sxc-primary" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
            {%- if section.settings.btn2_label != blank -%}<a class="sxc-btn sxc-ghost" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- assign coll = section.settings.collection -%}
  {%- if coll != blank and coll.products_count > 0 -%}
    <section class="sxc-section sxc-wrap">
      {%- if section.settings.products_title != blank -%}<h2 class="sxc-h2 sxc-mb">{{ section.settings.products_title }}</h2>{%- endif -%}
      {%- if section.settings.display == 'rows' -%}
        <div class="sxc-floors">
          {%- for product in coll.products limit: section.settings.products_to_show -%}
            <a class="sxc-floor" href="{{ product.url }}">
              <div><h3 class="sxc-h3">{{ product.title | replace: '"', '' }}</h3>{%- if product.type != blank -%}<div class="sxc-veh">{{ product.type }}</div>{%- endif -%}</div>
              <p>{{ product.description | strip_html | truncatewords: 22 }}</p>
              <div class="sxc-price">{% if product.price_varies %}From {% endif %}{{ product.price | money_without_trailing_zeros }}<small>{% if product.available %}supply / install{% else %}sold out{% endif %}</small></div>
              <span class="sxc-go">View →</span>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="sxc-cards">
          {%- for product in coll.products limit: section.settings.products_to_show -%}
            <a class="sxc-card" href="{{ product.url }}">
              <div class="sxc-ph">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width:1000px) 33vw, 100vw', alt: product.title }}
                {%- else -%}<div class="sxc-noimg"></div>{%- endif -%}
              </div>
              <div class="sxc-cb">
                <h3 class="sxc-h3">{{ product.title | replace: '"', '' }}</h3>
                <p>{{ product.description | strip_html | truncatewords: 20 }}</p>
                <div class="sxc-foot"><span class="sxc-price">{% if product.price_varies %}From {% endif %}{{ product.price | money_without_trailing_zeros }}</span><span class="sxc-go">{% if product.available %}Configure{% else %}Sold out{% endif %} →</span></div>
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </section>
  {%- elsif coll != blank -%}
    <section class="sxc-section sxc-wrap"><p class="sxc-empty">No products in this collection yet — add some, or pick another collection in the theme editor.</p></section>
  {%- endif -%}

  {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
  {%- if feature_blocks.size > 0 -%}
    <section class="sxc-section sxc-wrap">
      {%- if section.settings.features_title != blank -%}<h2 class="sxc-h2 sxc-mb">{{ section.settings.features_title }}</h2>{%- endif -%}
      <div class="sxc-feats">
        {%- for block in feature_blocks -%}
          <div class="sxc-feat" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}<span class="sxc-fk">{{ block.settings.kicker }}</span>{%- endif -%}
            <h3 class="sxc-h3">{{ block.settings.heading }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
  {%- if faq_blocks.size > 0 -%}
    <section class="sxc-section sxc-wrap">
      {%- if section.settings.faq_title != blank -%}<h2 class="sxc-h2 sxc-mb">{{ section.settings.faq_title }}</h2>{%- endif -%}
      <div class="sxc-faqs">
        {%- for block in faq_blocks -%}
          <details class="sxc-faq" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}</summary>
            <div class="sxc-faq-a">{{ block.settings.a }}</div>
          </details>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.cta_heading != blank -%}
    <section class="sxc-section sxc-wrap sxc-cta">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="sxc-label">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2 class="sxc-h2 sxc-cta-h">{{ section.settings.cta_heading }}</h2>
      {%- if section.settings.cta_text != blank -%}<p class="sxc-cta-p">{{ section.settings.cta_text }}</p>{%- endif -%}
      <div class="sxc-actions">
        {%- if section.settings.cta_btn1_label != blank -%}<a class="sxc-btn sxc-primary" href="{{ section.settings.cta_btn1_link | default: '#' }}">{{ section.settings.cta_btn1_label }}</a>{%- endif -%}
        {%- if section.settings.cta_btn2_label != blank -%}<a class="sxc-btn sxc-ghost" href="{{ section.settings.cta_btn2_link | default: '#' }}">{{ section.settings.cta_btn2_label }}</a>{%- endif -%}
      </div>
    </section>
  {%- endif -%}
</div>

{%- style -%}
  #sxc-{{ section.id }}.sxc{--bg:#000000;--surface:#141414;--surface2:#1a1a1a;--rule:#2a2a2a;--rule2:#3a3a3a;--ink:#ffffff;--grey:#777777;--grey2:#c0c0c0;--red:#c1272d;--red-deep:#8f1d22;--display:'Oswald',sans-serif;--mono:'DM Sans',sans-serif;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;}
  .sxc *{box-sizing:border-box;}
  .sxc a{text-decoration:none;color:inherit;}
  .sxc .sxc-wrap{max-width:1200px;margin-inline:auto;padding-inline:24px;}
  .sxc h1,.sxc h2,.sxc h3{font-family:var(--display);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:.94;margin:0;}
  .sxc .sxc-label,.sxc .sxc-fk{font-family:var(--mono);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--grey);margin:0;}
  .sxc :focus-visible{outline:2px solid var(--red);outline-offset:3px;}
  .sxc .sxc-btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.8rem;padding:14px 22px;border:1px solid;transition:transform .15s,background .15s;}
  .sxc .sxc-primary{background:var(--red);color:#fff;border-color:var(--red);}
  .sxc .sxc-primary:hover{background:var(--red-deep);transform:translateY(-2px);}
  .sxc .sxc-ghost{background:transparent;color:var(--ink);border-color:var(--rule2);}
  .sxc .sxc-ghost:hover{border-color:var(--ink);transform:translateY(-2px);}
  .sxc .sxc-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:32px;}

  .sxc .sxc-hero{padding-block:96px;border-bottom:1px solid var(--rule);position:relative;overflow:hidden;}
  .sxc .sxc-hero.has-img{min-height:62vh;display:flex;align-items:flex-end;}
  .sxc .sxc-hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
  .sxc .sxc-hero.has-img::after{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(100deg,rgba(14,13,12,.94),rgba(14,13,12,.55) 55%,rgba(14,13,12,.2));}
  .sxc .sxc-hero-inner{position:relative;z-index:2;width:100%;}
  .sxc .sxc-h1{font-size:clamp(2.4rem,6vw,4.4rem);max-width:18ch;}
  .sxc .sxc-h1 strong{color:var(--red);font-weight:900;}
  .sxc .sxc-intro{color:var(--grey2);max-width:52ch;margin-top:16px;font-size:1.15rem;}

  .sxc .sxc-section{padding-block:80px;border-bottom:1px solid var(--rule);}
  .sxc .sxc-h2{font-size:clamp(1.7rem,4vw,2.8rem);}
  .sxc .sxc-mb{margin-bottom:40px;}
  .sxc .sxc-empty{color:var(--grey);font-family:var(--mono);}

  .sxc .sxc-cards{display:grid;gap:24px;grid-template-columns:1fr;}
  .sxc .sxc-card{background:var(--surface);border:1px solid var(--rule);overflow:hidden;display:flex;flex-direction:column;transition:border-color .15s,transform .15s;}
  .sxc .sxc-card:hover{border-color:var(--rule2);transform:translateY(-3px);}
  .sxc .sxc-ph{aspect-ratio:16/10;overflow:hidden;background:var(--surface2);}
  .sxc .sxc-ph img{width:100%;height:100%;object-fit:cover;transition:transform .6s;}
  .sxc .sxc-card:hover .sxc-ph img{transform:scale(1.04);}
  .sxc .sxc-noimg{width:100%;height:100%;background:linear-gradient(135deg,var(--surface2),var(--surface));}
  .sxc .sxc-cb{padding:24px;display:flex;flex-direction:column;gap:12px;flex:1;}
  .sxc .sxc-h3{font-size:1.4rem;}
  .sxc .sxc-cb p,.sxc .sxc-floor p,.sxc .sxc-feat p{margin:0;color:var(--grey2);flex:1;}
  .sxc .sxc-foot{display:flex;align-items:flex-end;justify-content:space-between;border-top:1px solid var(--rule);padding-top:16px;gap:12px;}
  .sxc .sxc-price{font-family:var(--display);font-weight:900;font-size:1.35rem;}
  .sxc .sxc-price small{display:block;font-family:var(--mono);font-weight:400;font-size:.58rem;letter-spacing:.1em;color:var(--grey);}
  .sxc .sxc-go{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--grey2);white-space:nowrap;}
  .sxc .sxc-card:hover .sxc-go,.sxc .sxc-floor:hover .sxc-go{color:var(--red);}

  .sxc .sxc-floors{border-top:1px solid var(--rule);}
  .sxc .sxc-floor{display:grid;grid-template-columns:1fr auto;gap:14px 40px;align-items:center;padding-block:24px;border-bottom:1px solid var(--rule);transition:background .15s;}
  .sxc .sxc-floor:hover{background:var(--surface);}
  .sxc .sxc-veh{font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;color:var(--grey);margin-top:6px;}
  .sxc .sxc-floor .sxc-price{color:var(--red);text-align:right;}

  .sxc .sxc-feats{display:grid;gap:24px;grid-template-columns:1fr;}
  .sxc .sxc-feat{background:var(--surface);border:1px solid var(--rule);padding:28px;display:flex;flex-direction:column;gap:10px;}
  .sxc .sxc-feat .sxc-h3{font-size:1.25rem;}

  .sxc .sxc-faqs{display:grid;gap:0;border-top:1px solid var(--rule);}
  .sxc .sxc-faq{border-bottom:1px solid var(--rule);}
  .sxc .sxc-faq summary{cursor:pointer;list-style:none;padding:20px 0;font-family:var(--display);font-weight:700;text-transform:uppercase;font-size:1.05rem;display:flex;justify-content:space-between;gap:16px;}
  .sxc .sxc-faq summary::after{content:'+';color:var(--red);font-family:var(--mono);}
  .sxc .sxc-faq[open] summary::after{content:'–';}
  .sxc .sxc-faq summary::-webkit-details-marker{display:none;}
  .sxc .sxc-faq-a{padding:0 0 22px;color:var(--grey2);max-width:62ch;}

  .sxc .sxc-cta{}
  .sxc .sxc-cta-h{font-size:clamp(2rem,5vw,3.4rem);max-width:18ch;margin-top:16px;}
  .sxc .sxc-cta-h strong{color:var(--red);}
  .sxc .sxc-cta-p{color:var(--grey2);max-width:46ch;margin-top:16px;}

  @media(min-width:720px){ .sxc .sxc-cards{grid-template-columns:repeat(2,1fr);} .sxc .sxc-feats{grid-template-columns:repeat(3,1fr);} .sxc .sxc-floor{grid-template-columns:1.3fr 2fr auto auto;} }
  @media(min-width:1000px){ .sxc .sxc-cards{grid-template-columns:repeat(3,1fr);} }
  @media(max-width:719px){ .sxc .sxc-floor p{display:none;} }
  @media(prefers-reduced-motion:reduce){ .sxc *{transition:none!important;} }
{%- endstyle -%}

{% schema %}
{
  "name": "Splinter Category",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Category heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "btn1_label", "label": "Hero button 1 label" },
    { "type": "url", "id": "btn1_link", "label": "Hero button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Hero button 2 label" },
    { "type": "url", "id": "btn2_link", "label": "Hero button 2 link" },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "products_title", "label": "Products heading" },
    { "type": "select", "id": "display", "label": "Layout", "options": [ {"value":"cards","label":"Photo cards"}, {"value":"rows","label":"Spec rows"} ], "default": "cards" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 16, "step": 1, "default": 8 },
    { "type": "header", "content": "Sections" },
    { "type": "text", "id": "features_title", "label": "Features heading", "default": "Why this build" },
    { "type": "text", "id": "faq_title", "label": "FAQ heading", "default": "Common questions" },
    { "type": "header", "content": "Closing CTA" },
    { "type": "text", "id": "cta_eyebrow", "label": "CTA eyebrow" },
    { "type": "inline_richtext", "id": "cta_heading", "label": "CTA heading" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text" },
    { "type": "text", "id": "cta_btn1_label", "label": "CTA button 1 label" },
    { "type": "url", "id": "cta_btn1_link", "label": "CTA button 1 link" },
    { "type": "text", "id": "cta_btn2_label", "label": "CTA button 2 label" },
    { "type": "url", "id": "cta_btn2_link", "label": "CTA button 2 link" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "text", "id": "kicker", "label": "Kicker" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Feature" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]},
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Question?" },
      { "type": "textarea", "id": "a", "label": "Answer" }
    ]}
  ],
  "presets": [ { "name": "Splinter Category" } ]
}
{% endschema %}

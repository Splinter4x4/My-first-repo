{%- comment -%}
  Splinter Custom Quote — on-brand enquiry page for the Ride theme.
  Uses Shopify's native {% form 'contact' %}, so submissions land in your store
  email/notifications with no app required. Assign this section to the
  /pages/custom-quote page (template page.custom-quote).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

<div class="sxq" id="sxq-{{ section.id }}">
  <div class="sxq-wrap">
    <header class="sxq-head">
      {%- if section.settings.eyebrow != blank -%}<p class="sxq-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="sxq-h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<p class="sxq-intro">{{ section.settings.intro }}</p>{%- endif -%}
    </header>

    <div class="sxq-grid">
      <div class="sxq-formwrap">
        {%- form 'contact', class: 'sxq-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="sxq-success" role="status">Thanks — your enquiry's in. We'll be in touch within one business day on the email or phone you gave us.</p>
          {%- elsif form.errors -%}
            <p class="sxq-error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <div class="sxq-row">
            <div class="sxq-field">
              <label for="sxq-name">Name</label>
              <input type="text" id="sxq-name" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
            </div>
            <div class="sxq-field">
              <label for="sxq-phone">Phone</label>
              <input type="tel" id="sxq-phone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel" required>
            </div>
          </div>

          <div class="sxq-field">
            <label for="sxq-email">Email</label>
            <input type="email" id="sxq-email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
          </div>

          <div class="sxq-row">
            <div class="sxq-field">
              <label for="sxq-vehicle">Vehicle (make / model / year)</label>
              <input type="text" id="sxq-vehicle" name="contact[Vehicle]" placeholder="e.g. LandCruiser 300, 2023" required>
            </div>
            <div class="sxq-field">
              <label for="sxq-setup">Wagon or ute</label>
              <select id="sxq-setup" name="contact[Setup]">
                <option>Wagon</option>
                <option>Ute (tub)</option>
                <option>Canopy</option>
                <option>Not sure yet</option>
              </select>
            </div>
          </div>

          <fieldset class="sxq-field sxq-checks">
            <legend>What are you after? (tick all that apply)</legend>
            <label class="sxq-check"><input type="checkbox" name="contact[Interested in][]" value="Drawer system"> Drawer system</label>
            <label class="sxq-check"><input type="checkbox" name="contact[Interested in][]" value="False floor"> False floor</label>
            <label class="sxq-check"><input type="checkbox" name="contact[Interested in][]" value="12V package"> 12V package</label>
            <label class="sxq-check"><input type="checkbox" name="contact[Interested in][]" value="Full fitout"> Full fitout</label>
          </fieldset>

          <div class="sxq-row">
            <div class="sxq-field">
              <label for="sxq-fit">Supply or install</label>
              <select id="sxq-fit" name="contact[Supply or install]">
                <option>Supply only (ship to me)</option>
                <option>Supply + install in Neerabup</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="sxq-field">
              <label for="sxq-when">Rough timeframe</label>
              <select id="sxq-when" name="contact[Timeframe]">
                <option>As soon as possible</option>
                <option>Next 1–3 months</option>
                <option>Just planning for now</option>
              </select>
            </div>
          </div>

          <div class="sxq-field">
            <label for="sxq-body">Tell us about the build and how you tour</label>
            <textarea id="sxq-body" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="sxq-btn">Send my enquiry →</button>
          <p class="sxq-fine">We only use these details to quote your build. No lists, no spam.</p>
        {%- endform -%}
      </div>

      <aside class="sxq-aside">
        {%- if section.settings.aside_heading != blank -%}<h2 class="sxq-h2">{{ section.settings.aside_heading }}</h2>{%- endif -%}
        {%- if section.settings.aside_text != blank -%}<div class="sxq-rte">{{ section.settings.aside_text }}</div>{%- endif -%}
        <dl class="sxq-facts">
          <div><dt>Workshop</dt><dd>{{ section.settings.fact_location }}</dd></div>
          <div><dt>Lead time</dt><dd>{{ section.settings.fact_lead }}</dd></div>
          <div><dt>Shipping</dt><dd>{{ section.settings.fact_ship }}</dd></div>
        </dl>
        <div class="sxq-contact">
          {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{%- endif -%}
          {%- if section.settings.phone != blank -%}<a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>{%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</div>

{%- style -%}
  #sxq-{{ section.id }}.sxq{
    --bg:#0E0D0C;--surface:#161312;--surface2:#1E1A18;--rule:rgba(244,241,234,.12);--rule2:rgba(244,241,234,.22);
    --ink:#F4F1EA;--grey:#A8A097;--grey2:#CFC9C0;--red:#D8392B;--red-deep:#A4271D;
    --display:'Archivo',system-ui,sans-serif;--mono:'Space Mono',ui-monospace,monospace;
    background:var(--bg);color:var(--ink);font-family:'Inter',system-ui,sans-serif;
  }
  .sxq *{box-sizing:border-box;}
  .sxq .sxq-wrap{max-width:1100px;margin-inline:auto;padding:96px 24px;}
  .sxq h1,.sxq h2{font-family:var(--display);font-stretch:115%;font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:.94;margin:0;}
  .sxq .sxq-label{font-family:var(--mono);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--grey);margin:0 0 16px;}
  .sxq .sxq-h1{font-size:clamp(2.2rem,6vw,4rem);max-width:18ch;}
  .sxq .sxq-h1 strong{color:var(--red);font-weight:900;}
  .sxq .sxq-intro{color:var(--grey2);max-width:54ch;margin-top:16px;font-size:1.15rem;}
  .sxq .sxq-grid{display:grid;grid-template-columns:1fr;gap:48px;margin-top:56px;}
  .sxq .sxq-form{display:flex;flex-direction:column;gap:20px;}
  .sxq .sxq-row{display:grid;grid-template-columns:1fr;gap:20px;}
  .sxq .sxq-field{display:flex;flex-direction:column;gap:8px;}
  .sxq label,.sxq legend{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--grey2);}
  .sxq input,.sxq select,.sxq textarea{background:var(--surface);border:1px solid var(--rule2);color:var(--ink);font:inherit;padding:13px 14px;border-radius:0;}
  .sxq input:focus,.sxq select:focus,.sxq textarea:focus{outline:2px solid var(--red);outline-offset:2px;border-color:var(--red);}
  .sxq textarea{resize:vertical;}
  .sxq .sxq-checks{border:1px solid var(--rule);padding:16px;display:flex;flex-wrap:wrap;gap:10px 22px;}
  .sxq .sxq-checks legend{padding:0 6px;}
  .sxq .sxq-check{display:inline-flex;align-items:center;gap:8px;font-family:'Inter';font-size:.95rem;letter-spacing:0;text-transform:none;color:var(--grey2);}
  .sxq .sxq-check input{width:18px;height:18px;padding:0;accent-color:var(--red);}
  .sxq .sxq-btn{align-self:flex-start;font-family:var(--mono);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.85rem;background:var(--red);color:#fff;border:1px solid var(--red);padding:15px 26px;cursor:pointer;transition:background .15s ease,transform .15s ease;}
  .sxq .sxq-btn:hover{background:var(--red-deep);transform:translateY(-2px);}
  .sxq .sxq-fine{font-family:var(--mono);font-size:.66rem;letter-spacing:.04em;color:var(--grey);margin:0;}
  .sxq .sxq-success{background:rgba(40,90,40,.25);border:1px solid #3f7d3f;padding:14px 16px;color:#dff0df;}
  .sxq .sxq-error{background:rgba(120,30,25,.25);border:1px solid var(--red);padding:14px 16px;color:#ffd9d4;}
  .sxq .sxq-aside{background:var(--surface);border:1px solid var(--rule);padding:32px;align-self:start;}
  .sxq .sxq-h2{font-size:1.5rem;margin-bottom:14px;}
  .sxq .sxq-rte{color:var(--grey2);}
  .sxq .sxq-rte p{margin:0 0 10px;}
  .sxq .sxq-facts{margin:24px 0;display:grid;gap:1px;background:var(--rule);border:1px solid var(--rule);}
  .sxq .sxq-facts > div{background:var(--bg);padding:14px 16px;display:flex;justify-content:space-between;gap:16px;}
  .sxq .sxq-facts dt{font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--grey);}
  .sxq .sxq-facts dd{margin:0;font-weight:600;}
  .sxq .sxq-contact{display:flex;flex-direction:column;gap:6px;}
  .sxq .sxq-contact a{font-family:var(--mono);color:var(--ink);text-decoration:none;}
  .sxq .sxq-contact a:hover{color:var(--red);}
  @media(min-width:680px){ .sxq .sxq-row{grid-template-columns:1fr 1fr;} }
  @media(min-width:920px){ .sxq .sxq-grid{grid-template-columns:1.6fr 1fr;} }
  @media(prefers-reduced-motion:reduce){ .sxq *{transition:none!important;} }
{%- endstyle -%}

{% schema %}
{
  "name": "Splinter Custom Quote",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom quote · No obligation" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Tell us the rig. <strong>We'll build to it.</strong>" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Drawers, false floor, 12V or a full fitout — give us the vehicle and how you tour and we'll come back with a tailored quote. Built and installed in Neerabup, or shipped Australia-wide." },
    { "type": "header", "content": "Sidebar" },
    { "type": "text", "id": "aside_heading", "label": "Sidebar heading", "default": "What happens next" },
    { "type": "richtext", "id": "aside_text", "label": "Sidebar text", "default": "<p>We read every enquiry ourselves. You'll hear back within one business day with options and a price — or a few questions if we need them.</p>" },
    { "type": "text", "id": "fact_location", "label": "Workshop", "default": "Neerabup, WA" },
    { "type": "text", "id": "fact_lead", "label": "Lead time", "default": "2–6 weeks" },
    { "type": "text", "id": "fact_ship", "label": "Shipping", "default": "Australia-wide" },
    { "type": "text", "id": "email", "label": "Email", "default": "ethan@splinter4x4.com.au" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "0428 430 543" }
  ],
  "presets": [ { "name": "Splinter Custom Quote" } ]
}
{% endschema %}
